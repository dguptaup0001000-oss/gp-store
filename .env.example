# Copy this file to ".env" (same folder) and fill in real values.
# docker-compose reads ".env" automatically - it is NOT committed to git
# (see .gitignore) since it can contain real secrets once you're past local dev.

DB_NAME=gpstore
DB_USERNAME=gpstore
DB_PASSWORD=gpstore_dev_password

# Dev-only fallback - generate a real random 64+ character string for
# anything beyond local testing. Never reuse this value anywhere real.
JWT_SECRET=dev-only-change-me-GPSTORESECRETKEY123456789012345678901234567890

CORS_ALLOWED_ORIGINS=http://localhost:3000
