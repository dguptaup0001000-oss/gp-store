# Copy this file to ".env" (same folder) and fill in real values.
# docker-compose reads ".env" automatically - it is NOT committed to git
# (see .gitignore) since it can contain real secrets once you're past local dev.
#
# Hostinger production variables (placeholders) live in backend/.env.example.

DB_NAME=gpstore
DB_USERNAME=gpstore
DB_PASSWORD=gpstore_dev_password

# Dev-only fallback - generate a real random 64+ character string for
# anything beyond local testing. Never reuse this value anywhere real.
JWT_SECRET=dev-only-change-me-GPSTORESECRETKEY123456789012345678901234567890

CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Cashfree payment gateway
# ---------------------------------------------------------------------------
# EVERY VALUE BELOW IS A PLACEHOLDER. Real credentials go in .env (untracked)
# or, in production, in backend/.env on the VPS - never in this file and
# never in the Flutter app, which is shipped to customers and can be unpacked.
#
# Leaving CASHFREE_APP_ID / CASHFREE_SECRET_KEY empty is safe and deliberate:
# the gateway reports itself disabled and online checkout is refused with a
# clear error. COD and UPI are unaffected. Nothing half-configured can take a
# payment.
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# From the dashboard's webhook page, NOT the API credential above - they are
# different secrets. Empty means every webhook is rejected rather than
# trusted: the verifier fails closed.
CASHFREE_WEBHOOK_SECRET=

# Where Cashfree calls back. Must be publicly reachable and HTTPS, so
# localhost will not work - use a tunnel for local testing.
CASHFREE_NOTIFY_URL=
CASHFREE_RETURN_URL=

# Pinned API version. Cashfree changes response shapes between versions, so
# bump this deliberately after reading their changelog, not automatically.
CASHFREE_API_VERSION=2025-01-01
CASHFREE_TIMEOUT_SECONDS=10

# Redis: local laptop compose has no password. Hostinger Compose uses
# REDIS_HOST=redis and REDIS_PASSWORD (see backend/.env.example).
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
