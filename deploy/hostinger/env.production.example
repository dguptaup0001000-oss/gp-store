# LEGACY systemd EnvironmentFile template.
# Canonical production env is backend/.env.example (Docker Compose + Traefik).
# Do not use this file on a VPS that runs backend/docker-compose.yml.
#
# Copy to /opt/gpstore/env.production (mode 0600, owner gpstore) ONLY if you
# are recovering the old systemd layout. NEVER commit the filled file.
# systemd EnvironmentFile does NOT expand ${VAR} and does not like quotes.

PORT=8081
APP_PRODUCTION=true
FLYWAY_ENABLED=true
DDL_AUTO=validate

# LEGACY note: this file assumed systemd + Supabase. Canonical production is
# Compose Postgres on the VPS (backend/docker-compose.yml). Do not point a
# new Hostinger install at Supabase unless you are still reading from that
# database on purpose. Never migrate shop data without a dump and approval.
# Direct: jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# Pooler (when you outgrow the direct ceiling): port 6543 and prepareThreshold=0
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# Leave at project defaults unless you have measured a reason to change them.
# KVM 2 is 2 vCPU / 8 GB; these ceilings were set for that class of machine.
# DB_POOL_MAX_SIZE=10
# TOMCAT_MAX_THREADS=40
# TOMCAT_MAX_CONNECTIONS=500

JWT_SECRET=

# Redis on this VPS, localhost only. Must match requirepass in redis.conf.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Required behind Nginx so rate limits see the client IP, not 127.0.0.1.
RATE_LIMIT_TRUST_FORWARDED_FOR=true

# Comma-separated browser origins. Native Android does not use CORS.
# Example: https://dguptaup0001000-oss.github.io
CORS_ALLOWED_ORIGINS=

STORE_LATITUDE=27.162310
STORE_LONGITUDE=83.940468

# Cashfree. After DNS, notify must be the public HTTPS API:
#   CASHFREE_NOTIFY_URL=https://api.gpstore.co.in/v1/api/payments/webhooks/cashfree
# Also paste that exact URL in the Cashfree dashboard. Return URL is the
# customer-facing success/failure page (app deep link or HTTPS page).
CASHFREE_ENVIRONMENT=production
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_NOTIFY_URL=
CASHFREE_RETURN_URL=
CASHFREE_API_VERSION=2025-01-01

# MSG91 SMS OTP is optional. Empty credentials: app boots, OTP send fails closed.
MSG91_ENABLED=false
OTP_SMS_SENDING_ENABLED=false
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=GPSTOR

FIREBASE_PUSH_ENABLED=true
FIREBASE_CREDENTIALS_BASE64=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

STORE_UPI_ID=
STORE_UPI_PAYEE_NAME=GP Store
STORE_SUPPORT_PHONE=
STORE_SUPPORT_WHATSAPP=
STORE_SUPPORT_EMAIL=
STORE_SUPPORT_URL=

# systemd TimeoutStopSec is 40s on this VPS (not a 30s PaaS SIGKILL).
SHUTDOWN_TIMEOUT=30s

# KVM 2: 8 GB RAM, 2 vCPU. Heap is ~35% of the machine when not cgroup-limited.
JVM_MAX_RAM_PERCENT=35
JVM_MAX_METASPACE=256m
JVM_CODE_CACHE=64m
JVM_MAX_DIRECT=32m
JVM_THREAD_STACK=512k
JVM_ACTIVE_PROCESSORS=2
JVM_GC=-XX:+UseG1GC
JVM_OOM_BEHAVIOUR=-XX:+ExitOnOutOfMemoryError
MALLOC_ARENA_MAX=2
