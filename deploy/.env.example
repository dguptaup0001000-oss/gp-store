# GP-STORE production environment.
#
# COPY THIS TO deploy/.env AND FILL IT IN. deploy/.env is gitignored and must
# NEVER be committed - every value below is a real secret or a real target.

# ---- Domain -----------------------------------------------------------
# The hostname Caddy will obtain a TLS certificate for. Its DNS A/AAAA
# record must already point at this VPS before the stack starts, or the
# ACME challenge fails and Caddy retries into a rate limit.
APP_DOMAIN=api.example.com

# ---- Image ------------------------------------------------------------
# Published by the build-and-push-image CI job on every merge to main.
BACKEND_IMAGE=ghcr.io/dguptaup0001000-oss/gp-store:latest

# ---- Database (Supabase) ---------------------------------------------
# Use the TRANSACTION POOLER (Supavisor), not the direct connection: the
# direct one has a low hard connection ceiling shared by every client.
# Port 6543, and prepareThreshold=0 is REQUIRED - the pooler hands out a
# different physical connection per transaction, which breaks the JDBC
# driver's server-side prepared-statement cache.
DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=

# ---- Secrets ----------------------------------------------------------
# At least 32 characters. The app refuses to start in production if this is
# missing, too short, or still the published development value.
JWT_SECRET=

# ---- CORS -------------------------------------------------------------
# Comma-separated, no wildcard. The Flutter mobile app does not need a CORS
# entry (it is not a browser); this is for the web build only.
CORS_ALLOWED_ORIGINS=https://dguptaup0001000-oss.github.io

# ---- Sizing -----------------------------------------------------------
# See DEPLOY-ARM64.md for how to choose these. The defaults below suit a
# 4 vCPU / 4 GB box. Raise deliberately, then re-run the load test.
TOMCAT_MAX_THREADS=100
DB_POOL_MAX_SIZE=20
BACKEND_MEMORY_LIMIT=3g
REDIS_MAXMEMORY=256mb

# Schema is owned by Flyway migrations in production, not by Hibernate.
DDL_AUTO=validate

# Extra JVM flags, appended after the image's own defaults. Normally empty.
JAVA_OPTS=
