# Real Play Store release signing - one-time setup, on YOUR OWN machine
#
# Deliberately not generated by anything in this project, and never should
# be. A Play Store signing key is the permanent identity of your app -
# generate it yourself, on hardware you control, and never let its private
# key material pass through anyone else's systems, including an AI's.
#
# STEP 1 - generate your real keystore (run this yourself, in a terminal,
# on your own machine - requires a JDK, which you already have if you can
# build this Android app at all):
#
#   keytool -genkey -v -keystore ~/gpstore-release-key.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias gpstore
#
# It will prompt you for a store password, your name/org details, and a
# key password (can be the same as the store password). Keep this file and
# both passwords somewhere safe and backed up - if you lose them, you
# cannot publish updates to the same Play Store listing ever again.
#
# STEP 2 - copy this file to android/key.properties (same folder as this
# example) and fill in your real values:
#
#   cp android/key.properties.example android/key.properties
#
# Then edit android/key.properties with a real text editor and replace
# every placeholder below with your real values from Step 1.
#
# STEP 3 - build for real:
#
#   flutter build appbundle --release
#
# (Play Store submissions want an .aab app bundle, not the .apk this
# project's CI workflow produces for quick testing - same underlying
# signing config, different output format, both handled by this same file
# once it's filled in.)

storePassword=REPLACE_WITH_YOUR_KEYSTORE_PASSWORD
keyPassword=REPLACE_WITH_YOUR_KEY_PASSWORD
keyAlias=gpstore
storeFile=/absolute/path/to/your/gpstore-release-key.jks
