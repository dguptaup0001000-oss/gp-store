<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.3</version>
        <relativePath/>
    </parent>

    <groupId>com.gpstore</groupId>
    <artifactId>backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>backend</name>
    <description>GP Store Backend</description>

    <properties>
        <java.version>21</java.version>
        <!-- Pinned explicitly rather than trusting spring-boot-starter-parent's
             managed version - if your JDK is newer than what that managed
             version supports, Lombok's annotation processor can silently
             generate NOTHING (no error, just missing getters/setters
             everywhere) rather than fail loudly, exactly the failure this
             comment originally warned about. It happened for real: CI's
             hosted runner drifted to a newer Temurin 21 patch (21.0.12)
             than 1.18.34 handled reliably, and the exact same "cannot find
             symbol" pattern reproduced in a from-scratch build even though
             nothing in the source had changed. Bumped to 1.18.46 (current
             as of this fix) - if this ever recurs, run `java -version` and
             check whether Lombok has since fallen behind the JDK patch
             level again. -->
        <lombok.version>1.18.46</lombok.version>
    </properties>

    <dependencies>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>

        <!-- Shared cache + distributed rate-limit store across instances -
             see application.properties' spring.cache.type and
             config.RateLimitFilter's doc comments for why an in-memory
             cache/rate-limiter breaks correctness the moment you run more
             than one backend instance. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Process-local L1 in front of Redis (see TwoLevelCacheManager).
             Catalog reads under a load test were paying a Redis round trip
             on every hit even when the value had not changed. -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.8.8</version>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Coordinates @Scheduled jobs across multiple app instances - without
             this, running more than one backend instance means every instance
             fires every scheduled job (payment expiry, batching, etc.)
             redundantly and simultaneously. See config.SchedulerLockConfig and
             db/migration/V3__add_shedlock_table.sql.
             NOTE: version pinned from general knowledge, not verified live
             against Maven Central (no network access when this was written) -
             if `mvn compile` can't resolve it, check
             https://mvnrepository.com/artifact/net.javacrumbs.shedlock/shedlock-spring
             for the current release compatible with Spring Boot 3.5.x and
             adjust both version numbers below to match. -->
        <dependency>
            <groupId>net.javacrumbs.shedlock</groupId>
            <artifactId>shedlock-spring</artifactId>
            <version>5.13.0</version>
        </dependency>
        <dependency>
            <groupId>net.javacrumbs.shedlock</groupId>
            <artifactId>shedlock-provider-jdbc-template</artifactId>
            <version>5.13.0</version>
        </dependency>

        <!-- Real push notifications (order status updates to customers, new
             assignment alerts to delivery partners) via Firebase Cloud
             Messaging - the actual provider integration NotificationService
             used to only stub out (see its doc comments). Requires a real
             Firebase project + service account key, which can't be
             fabricated here - see FirebaseConfig for the env var this reads. -->
        <dependency>
            <groupId>com.google.firebase</groupId>
            <artifactId>firebase-admin</artifactId>
            <version>9.4.1</version>
        </dependency>

        <!-- Cloudflare R2 is S3-compatible. Used only on the Hostinger
             backend to mint short-lived upload URLs. Credentials never go
             to Flutter. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
            <version>2.29.51</version>
        </dependency>


        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.11.5</version>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.11.5</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.11.5</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Pinned explicitly - spring-boot-starter-test's transitively managed
             Mockito version can be too old for whatever JDK point-release you're
             on, causing "Could not initialize plugin: MockMaker" (Mockito's
             ByteBuddy-based mocking can't instrument classes on a JDK it
             doesn't yet support). This is a well-documented Mockito/JDK
             compatibility issue, not a bug in the test code itself. -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>5.14.2</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>5.14.2</version>
            <scope>test</scope>
        </dependency>

        <!-- Bulk catalogue import. A shopkeeper with 10,000 products cannot
             type them in one at a time, and the two formats they actually
             have are a spreadsheet export and a CSV.

             commons-csv rather than splitting on commas: a product called
             "Haldiram's Bhujia, 200 g" contains a comma, a description
             contains quotes, and an Excel export contains embedded newlines
             inside quoted cells. Hand-rolled splitting corrupts exactly the
             rows a shopkeeper is least likely to notice.

             poi-ooxml reads .xlsx directly, because telling a shop to
             "save as CSV first" is where the encoding of a rupee sign and a
             Hindi product name goes wrong. -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-csv</artifactId>
            <version>1.11.0</version>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.3.0</version>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Newer JDKs restrict runtime bytecode-agent self-attach
                         by default, which is exactly what Mockito's ByteBuddy
                         mock maker needs to do its job. This flag allows it. -->
                    <argLine>-XX:+EnableDynamicAgentLoading</argLine>
                    <!-- Empty-database Flyway tests need a real migrate against
                         a clean Postgres and a second boot with ddl-auto=validate.
                         The default verify job still uses FLYWAY_ENABLED=false, so
                         those tests are excluded here and selected by the
                         schema-bootstrap profile (see .github/workflows/ci.yml). -->
                    <excludedGroups>schema-bootstrap</excludedGroups>
                    <systemPropertyVariables>
                        <!-- A SMALL POOL FOR TESTS, and this is not the test
                             environment being special for its own sake - it is
                             the one place the production setting's real cost is
                             visible, so it is worth writing down here.

                             Production runs a FIXED pool: minimum-idle equals
                             maximum-pool-size, so the pool never has to grow
                             during a burst (see application.properties). The
                             cost of that is that every application INSTANCE
                             holds its full pool open permanently - connections
                             multiply by instance count, against whatever
                             budget Postgres or Supabase allows.

                             A test run is the extreme case. Spring caches a
                             separate application context per distinct test
                             configuration and never closes them, so a full
                             suite ends up with a dozen or more live contexts,
                             each holding its own pool. At ten apiece that is
                             150+ connections against a local Postgres whose
                             default max_connections is 100 - and the run dies
                             with "FATAL: sorry, too many clients already",
                             which is what happened the first time.

                             Two here, and a ceiling of five. Tests are
                             single-threaded per context and need almost
                             nothing; what they must not do is starve each
                             other. The production values are asserted from the
                             properties file by ConnectionHoldTimeTest, so
                             overriding them here cannot hide a regression in
                             the setting that actually ships. -->
                        <spring.datasource.hikari.minimum-idle>1</spring.datasource.hikari.minimum-idle>
                        <spring.datasource.hikari.maximum-pool-size>5</spring.datasource.hikari.maximum-pool-size>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- Static analysis - catches real bug patterns (null derefs, resource
                 leaks, always-false comparisons) at build time. Runs fully
                 locally, unlike SonarCloud which needs an external account and
                 token.

                 THE TRIAGE THIS WAS WAITING ON HAS HAPPENED. This plugin sat
                 here configured and unbound for months with a comment saying
                 it would be bound "until that triage happens" - so it only
                 ever ran when somebody thought to run it, which nobody did.
                 The first real run found EC_UNRELATED_TYPES in
                 WorkerOrderView: a String compared to an enum, always false,
                 which meant every rider was told to collect nothing on a
                 cash-on-delivery order. It had never worked, and three passes
                 of manual review had read straight past it.

                 All 332 findings were then categorised (see spotbugs-gate.xml
                 for the breakdown and the reasoning) and the gate below is
                 scoped to the categories that are at ZERO today, so it starts
                 green and any new finding in them is a genuine regression.

                 Bound to `verify`, which is what CI runs (./mvnw -B clean
                 verify) - so a plain `mvn test` loop stays fast locally and
                 nothing reaches main without passing it. -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>4.8.6.4</version>
                <configuration>
                    <effort>Max</effort>
                    <threshold>Medium</threshold>
                    <!-- PLUGIN level, not execution level, and that is load
                         bearing. The `check` goal FORKS the `spotbugs`
                         analysis goal, and the forked goal does not inherit
                         execution-level configuration - a filter set only on
                         the execution below is silently ignored, the analysis
                         runs unfiltered, and the gate then fails on all 330
                         findings including the 306 entity-getter ones. That
                         was the first thing tried here; it does not work.

                         To see the unfiltered set, override this:
                           -Dspotbugs.includeFilterFile=spotbugs-all.xml -->
                    <includeFilterFile>spotbugs-gate.xml</includeFilterFile>
                </configuration>
                <executions>
                    <execution>
                        <id>correctness-gate</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

    <profiles>
        <profile>
            <id>schema-bootstrap</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <groups>schema-bootstrap</groups>
                            <!-- Override the default exclusion so this profile
                                 is the only way these tests run. -->
                            <excludedGroups combine.self="override"/>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
