<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.3</version>
        <relativePath/>
    </parent>

    <groupId>com.gpstore</groupId>
    <artifactId>backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>backend</name>
    <description>GP Store Backend</description>

    <properties>
        <java.version>21</java.version>
        <!-- Pinned explicitly rather than trusting spring-boot-starter-parent's
             managed version - if your JDK is newer than what that managed
             version supports, Lombok's annotation processor can silently
             generate NOTHING (no error, just missing getters/setters
             everywhere) rather than fail loudly. 1.18.34 is a current release
             with active JDK 21+ support. If you still see "cannot find
             symbol" errors on Lombok-generated methods after this, run
             `java -version` in Termux and tell me the exact version -
             we may need to bump this further. -->
        <lombok.version>1.18.34</lombok.version>
    </properties>

    <dependencies>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>

        <!-- Shared cache + distributed rate-limit store across instances -
             see application.properties' spring.cache.type and
             config.RateLimitFilter's doc comments for why an in-memory
             cache/rate-limiter breaks correctness the moment you run more
             than one backend instance. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.8.8</version>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Coordinates @Scheduled jobs across multiple app instances - without
             this, running more than one backend instance means every instance
             fires every scheduled job (payment expiry, batching, etc.)
             redundantly and simultaneously. See config.SchedulerLockConfig and
             db/migration/V3__add_shedlock_table.sql.
             NOTE: version pinned from general knowledge, not verified live
             against Maven Central (no network access when this was written) -
             if `mvn compile` can't resolve it, check
             https://mvnrepository.com/artifact/net.javacrumbs.shedlock/shedlock-spring
             for the current release compatible with Spring Boot 3.5.x and
             adjust both version numbers below to match. -->
        <dependency>
            <groupId>net.javacrumbs.shedlock</groupId>
            <artifactId>shedlock-spring</artifactId>
            <version>5.13.0</version>
        </dependency>
        <dependency>
            <groupId>net.javacrumbs.shedlock</groupId>
            <artifactId>shedlock-provider-jdbc-template</artifactId>
            <version>5.13.0</version>
        </dependency>

        <!-- Real push notifications (order status updates to customers, new
             assignment alerts to delivery partners) via Firebase Cloud
             Messaging - the actual provider integration NotificationService
             used to only stub out (see its doc comments). Requires a real
             Firebase project + service account key, which can't be
             fabricated here - see FirebaseConfig for the env var this reads. -->
        <dependency>
            <groupId>com.google.firebase</groupId>
            <artifactId>firebase-admin</artifactId>
            <version>9.4.1</version>
        </dependency>


        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.11.5</version>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.11.5</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.11.5</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Pinned explicitly - spring-boot-starter-test's transitively managed
             Mockito version can be too old for whatever JDK point-release you're
             on, causing "Could not initialize plugin: MockMaker" (Mockito's
             ByteBuddy-based mocking can't instrument classes on a JDK it
             doesn't yet support). This is a well-documented Mockito/JDK
             compatibility issue, not a bug in the test code itself. -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>5.14.2</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>5.14.2</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Newer JDKs restrict runtime bytecode-agent self-attach
                         by default, which is exactly what Mockito's ByteBuddy
                         mock maker needs to do its job. This flag allows it. -->
                    <argLine>-XX:+EnableDynamicAgentLoading</argLine>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- Static analysis - catches real bug patterns (null derefs, resource
                 leaks, etc.) at build time. Runs fully locally, unlike SonarCloud
                 which needs an external account/token - appropriate for now.
                 Run manually with: mvn com.github.spotbugs:spotbugs-maven-plugin:check -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>4.8.6.4</version>
                <configuration>
                    <effort>Max</effort>
                    <threshold>Medium</threshold>
                    <!-- Not bound to a build phase by default - a first run on
                         an existing large codebase can surface a lot of noise
                         to triage. Run it deliberately (command above) rather
                         than blocking every build until that triage happens. -->
                </configuration>
            </plugin>

        </plugins>
    </build>

</project>
