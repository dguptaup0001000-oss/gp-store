# Copy to ".env" in this folder (backend/) before `docker compose up`.
# docker compose reads ".env" automatically. It is gitignored.
#
# EVERY VALUE THAT SAYS CHANGE_ME MUST BE REPLACED. Do not commit the filled
# file. Production (APP_PRODUCTION=true) refuses CHANGE_ME / empty DB, Redis,
# JWT, and STORE_SUPPORT_* placeholders and will not boot.

# Traefik / Let's Encrypt (hostname only, no https://, no trailing slash)
API_DOMAIN=api.gpstore.co.in
ACME_EMAIL=CHANGE_ME_TO_AN_EMAIL_YOU_CONTROL

SPRING_PROFILES_ACTIVE=prod

DB_NAME=gpstore
DB_USERNAME=gpstore
DB_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_PLUS_CHARACTER_SECRET

# Comma-separated browser origins. Native Android does not use CORS. Do not use *.
# Include GitHub Pages if account-deletion.html is served from there.
CORS_ALLOWED_ORIGINS=https://dguptaup0001000-oss.github.io

# Malhia shop pin (same defaults as application.properties). Change if the shop moves.
STORE_LATITUDE=27.162310
STORE_LONGITUDE=83.940468

# Customer-facing Contact Us. Production boot refuses placeholders.
# Set real values on the VPS; never commit them.
STORE_SUPPORT_PHONE=
STORE_SUPPORT_WHATSAPP=
STORE_SUPPORT_EMAIL=
STORE_SUPPORT_URL=

# Redis is required (cache + rate limits). Same value as redis --requirepass.
# Production Compose does NOT put this in container Env. deploy.sh copies it
# to backend/.secrets/redis_password (mode 0644 inside directory .secrets
# mode 0700; 0600 is unreadable by appuser/redis) and mounts it as a
# Docker secret. Manual `docker compose up` from backend/ also needs that
# file:
#   python3 docker/redis/materialize-password-file.py .
REDIS_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_REDIS_PASSWORD

# Automated Postgres backups (Compose `backup` service). Custom-format
# .dump files on the VPS volume until you copy them off-box (see
# deploy/production/BACKUPS.md). 14 days; never deletes the latest success.
# Production boot refuses CHANGE_ME / empty STORE_SUPPORT_* / weak JWT.
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=21600
# Sidecar healthcheck: SUCCESS dump must be newer than this (minutes). 1560 = 26h.

# Production MUST be validate or none. SchemaSafetyGuard refuses to boot
# if this is update/create/create-drop/drop when APP_PRODUCTION=true.
DDL_AUTO=validate
FLYWAY_ENABLED=true
APP_PRODUCTION=true

# Cashfree (optional; empty disables online checkout; COD/UPI still work)
CASHFREE_ENVIRONMENT=production
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
# Must match the Cashfree dashboard. Production host is api.gpstore.co.in.
CASHFREE_NOTIFY_URL=https://api.gpstore.co.in/v1/api/payments/webhooks/cashfree
CASHFREE_RETURN_URL=

# Shop OTP is email. SMTP_* stay empty/CHANGE_ME in git. Never commit a
# real mailbox password. MSG91/SMS stays in the tree but is disabled.
OTP_CHANNEL=EMAIL
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Optional. Key for the OTP hash in otp_verification. Leave EMPTY unless you
# want the OTP key rotated separately from JWT_SECRET - when empty it derives
# from JWT_SECRET, which production already requires. Never commit a real one.
OTP_HASH_SECRET=

# MSG91 SMS OTP is optional and abandoned for shop login. Leave disabled.
MSG91_ENABLED=false
OTP_SMS_SENDING_ENABLED=false
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=GPSTOR

FIREBASE_PUSH_ENABLED=false
FIREBASE_CREDENTIALS_BASE64=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional. Defaults to gp-store/products when unset.
CLOUDINARY_UPLOAD_FOLDER=gp-store/products
CLOUDINARY_SIGNATURE_ENABLED=false

# Cloudflare R2 (S3 API). New admin photo uploads. The bucket is private.
# Compose interpolates these from THIS file (backend/.env on the VPS).
# /opt/gpstore/env-production is NOT read by Docker. Copy names with
# deploy/production/merge-r2-env.sh (never prints values). Leave blank
# until the token exists; the app boots, and POST /api/uploads/sign then
# fails closed. Never commit filled values. Never put these in Flutter.
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional. Leave empty to serve images with short-lived signed GET URLs
# (recommended). Only set this if a custom HTTPS domain fronts the bucket.
R2_PUBLIC_BASE_URL=
# Cloudflare Worker bound to the private bucket (stable CDN URLs).
# Leave empty to keep presigned GET. Do not make the bucket public.
R2_IMAGE_WORKER_BASE_URL=

# TLS expiry probe (admin ops status). Hostname only.
OPS_TLS_CHECK_HOST=api.gpstore.co.in
