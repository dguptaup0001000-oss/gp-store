# Copy to ".env" in this folder (backend/) before `docker compose up`.
# docker compose reads ".env" automatically. It is gitignored.
#
# EVERY VALUE THAT SAYS CHANGE_ME MUST BE REPLACED. Do not commit the filled
# file. Native Android does not use CORS; CORS_ALLOWED_ORIGINS is for browsers.

# Traefik / Let's Encrypt (hostname only, no https://, no trailing slash)
API_DOMAIN=api.gpstore.co.in
ACME_EMAIL=CHANGE_ME_TO_AN_EMAIL_YOU_CONTROL

SPRING_PROFILES_ACTIVE=prod

DB_NAME=gpstore
DB_USERNAME=gpstore
DB_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_PLUS_CHARACTER_SECRET

# Comma-separated browser origins. Native Android does not use CORS. Do not use *.
# Include GitHub Pages if account-deletion.html is served from there.
CORS_ALLOWED_ORIGINS=https://dguptaup0001000-oss.github.io

# Malhia shop pin (same defaults as application.properties). Change if the shop moves.
STORE_LATITUDE=27.162310
STORE_LONGITUDE=83.940468

# Customer-facing Contact Us / store-info. Empty keeps the application.properties
# placeholders (+91XXXXXXXXXX / support@example.com). Fill real values on the
# VPS .env only; then `docker compose up -d backend`. Do not commit filled values.
STORE_SUPPORT_PHONE=
STORE_SUPPORT_WHATSAPP=
STORE_SUPPORT_EMAIL=

# Redis is required (cache + rate limits). Same value as redis --requirepass.
REDIS_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_REDIS_PASSWORD

DDL_AUTO=validate
FLYWAY_ENABLED=true
APP_PRODUCTION=true

# Cashfree (optional; empty disables online checkout; COD/UPI still work)
CASHFREE_ENVIRONMENT=production
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
# Must match the Cashfree dashboard. Production host is api.gpstore.co.in.
CASHFREE_NOTIFY_URL=https://api.gpstore.co.in/v1/api/payments/webhooks/cashfree
CASHFREE_RETURN_URL=

# MSG91 SMS OTP is optional. Production boots without it; OTP send fails
# closed (no mock, no fake SMS) until a real Auth Key and template ID exist.
MSG91_ENABLED=false
OTP_SMS_SENDING_ENABLED=false
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=GPSTOR

FIREBASE_PUSH_ENABLED=false
FIREBASE_CREDENTIALS_BASE64=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
