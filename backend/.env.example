# Copy to ".env" in this folder (backend/) before `docker compose up`.
# docker compose reads ".env" automatically. It is gitignored.
#
# EVERY VALUE THAT SAYS CHANGE_ME MUST BE REPLACED. Do not commit the filled
# file. Native Android does not use CORS; CORS_ALLOWED_ORIGINS is for browsers.

# Traefik / Let's Encrypt (no https://, no trailing slash)
API_DOMAIN=YOUR_API_DOMAIN
ACME_EMAIL=CHANGE_ME_TO_AN_EMAIL_YOU_CONTROL

SPRING_PROFILES_ACTIVE=prod

DB_NAME=gpstore
DB_USERNAME=gpstore
DB_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_PLUS_CHARACTER_SECRET

# Comma-separated. Native apps ignore CORS. Do not use *.
CORS_ALLOWED_ORIGINS=https://YOUR-FRONTEND-DOMAIN

# Malhia shop pin (same defaults as application.properties). Change if the shop moves.
STORE_LATITUDE=27.162310
STORE_LONGITUDE=83.940468

# Redis is required (cache + rate limits). Same value as redis --requirepass.
REDIS_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_REDIS_PASSWORD

DDL_AUTO=validate
FLYWAY_ENABLED=true
APP_PRODUCTION=true

# Cashfree (optional; empty disables online checkout; COD/UPI still work)
CASHFREE_ENVIRONMENT=production
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
# Must be public HTTPS after DNS, e.g. https://YOUR_API_DOMAIN/v1/api/payments/webhooks/cashfree
CASHFREE_NOTIFY_URL=
CASHFREE_RETURN_URL=

# MSG91 (production OTP refuses to boot on the mock when APP_PRODUCTION=true)
MSG91_ENABLED=true
OTP_SMS_SENDING_ENABLED=true
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=GPSTOR

FIREBASE_PUSH_ENABLED=false
FIREBASE_CREDENTIALS_BASE64=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
