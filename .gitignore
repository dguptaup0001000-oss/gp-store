### Editor/manual backup files - stale snapshots left in place during
### editing, never meant to be committed or compiled ###
*.bak
*.orig

### Claude Code tooling scratch space (agent worktrees, etc.) ###
.claude/

### Load test output - holds real access tokens for seeded test accounts ###
load-tests/accounts.json

# Redis snapshot written by a locally-run redis-server during testing.
# Build artifact, not source, and can be large.
dump.rdb
**/dump.rdb

# Postgres dumps must never enter git (credentials live in the dump).
*.dump
gpstore-*.sql.gz
/backups/
**/.secrets/

# Android release signing — never commit the operator keystore or CI copy.
*.jks
*.keystore
*.p12
*.b64
key.properties
upload-keystore.jks

# Python bytecode. Six .pyc files were tracked, which is worse than untidy:
# a stale .pyc shadows an edited .py for anyone whose interpreter matches the
# cached magic number, so a CI script could run code nobody can see in the
# diff. They are also interpreter-version specific and conflict on every
# merge.
__pycache__/
*.py[cod]
