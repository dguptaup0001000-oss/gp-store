<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Every screen in this app talks to the backend API. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Needed for the "use my current location" button when adding an
         address (see AddAddressScreen / geolocator package) - without
         these, Geolocator.getCurrentPosition() fails at runtime even if
         the code is otherwise correct. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>

    <!-- Android 13+ (API 33) requires this at runtime for any notification
         to show at all, including push. PushNotificationService's
         requestPermission() call (see push_notification_service.dart)
         triggers the actual OS prompt for it - this manifest entry just
         declares that the app is allowed to ask. Below API 33 this is a
         no-op (no such runtime permission exists there). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Needed to connect to a paired Bluetooth thermal printer for
         auto-printing new-order receipts (see core/printing/printer_service.dart).
         BLUETOOTH_CONNECT is the Android 12+ (API 31+) runtime permission
         for talking to an already-paired device - no location permission
         needed since this app only ever connects to a device the store
         owner already paired themselves in Android's Bluetooth settings, it
         never scans for new ones. android:usesPermissionFlags="neverForLocation"
         on BLUETOOTH_SCAN documents that same fact to the Play Store, in
         case a future version of this feature does add scanning. Below API
         31, the legacy BLUETOOTH/BLUETOOTH_ADMIN permissions apply instead -
         granted at install time, no runtime prompt. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation"/>

    <application
        android:label="GP-Store"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <!-- Shows the launch_background.xml drawable as the app starts,
                 then Flutter draws the real first frame on top and this
                 theme is switched away automatically - standard Flutter
                 splash-screen pattern. -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Don't delete this - required by the Flutter tool for correct
             Dart VM / engine detection. -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>
