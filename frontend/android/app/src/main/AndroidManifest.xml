<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Every screen in this app talks to the backend API. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Needed for the "use my current location" button when adding an
         address (see AddAddressScreen / geolocator package) - without
         these, Geolocator.getCurrentPosition() fails at runtime even if
         the code is otherwise correct. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>

    <application
        android:label="GP-Store"
        android:name="${applicationName}"
        android:icon="@drawable/ic_launcher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <!-- Shows the launch_background.xml drawable as the app starts,
                 then Flutter draws the real first frame on top and this
                 theme is switched away automatically - standard Flutter
                 splash-screen pattern. -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Don't delete this - required by the Flutter tool for correct
             Dart VM / engine detection. -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>
